{
  "version": 2,
  "builds": [
    {
      "src": "server.ts",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server.ts"
    },
    {
      "src": "/ads.txt",
      "dest": "/dist/ads.txt"
    },
    {
      "src": "/robots.txt",
      "dest": "/dist/robots.txt"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/dist/sitemap.xml"
    },
    {
      "src": "/(.*)",
      "dest": "/dist/$1"
    }
  ]
}
